10 REM END-TO-END: INVERSE OF A 300 BY 300 DIAGONALLY DOMINANT TABLE FIVE TIMES,
20 REM THEN A * INV(A) COMPARED WITH THE IDENTITY (THE COUNT OF BAD ELEMENTS IS 0)
30 DIM A(300,300), B(300,300), C(300,300)
40 FOR I = 1 TO 300
50 FOR J = 1 TO 300
60 LET T = I*J
70 LET A(I,J) = T - 7*INT(T/7) - 3
80 NEXT J
90 LET A(I,I) = A(I,I) + 1000
100 NEXT I
110 FOR K = 1 TO 5
120 MAT B = INV(A)
130 NEXT K
140 MAT C = A * B
150 LET E1 = 0
160 FOR I = 1 TO 300
170 FOR J = 1 TO 300
180 LET D1 = C(I,J)
190 IF I <> J THEN 210
200 LET D1 = D1 - 1
210 IF ABS(D1) <= 1E-9 THEN 230
220 LET E1 = E1 + 1
230 NEXT J
240 NEXT I
250 PRINT "INVERSE 300 X 300"
260 PRINT "OFF IDENTITY", E1
270 END
