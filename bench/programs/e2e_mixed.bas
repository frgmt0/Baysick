10 REM END-TO-END: MAT READ FROM DATA, SUM, DIFFERENCE, SCALAR MULTIPLE,
20 REM TRANSPOSE AND PRODUCT, THEN MAT PRINT OF A SUMMARY ROW (EXACT INTEGERS)
30 DIM A(3,4), B(3,4), C(3,4), T(4,3), D(4,4), S(1,4)
40 MAT READ A, B
50 MAT C = A + B
60 MAT C = C - A
70 MAT C = (3)*C
80 MAT T = TRN(C)
90 MAT D = T * C
100 FOR J = 1 TO 4
110 LET S(1,J) = D(1,J) + D(2,J) + D(3,J) + D(4,J)
120 NEXT J
130 MAT PRINT S
140 DATA 1, -2, 3, 4
150 DATA 5, 6, -7, 8
160 DATA 9, 10, 11, -12
170 DATA 2, 0, -1, 3
180 DATA -4, 5, 1, 2
190 DATA 6, -3, 2, 1
200 END
