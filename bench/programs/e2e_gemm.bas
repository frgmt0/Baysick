10 REM END-TO-END: TWO 400 BY 400 TABLES FILLED WITH SMALL INTEGERS BY LET LOOPS,
20 REM THEIR PRODUCT COMPUTED TEN TIMES, AN EXACT INTEGER CHECKSUM PRINTED
30 DIM A(400,400), B(400,400), C(400,400)
40 FOR I = 1 TO 400
50 FOR J = 1 TO 400
60 LET T = I*J
70 LET A(I,J) = T - 9*INT(T/9) - 4
80 LET T = I + 2*J
90 LET B(I,J) = T - 7*INT(T/7) - 3
100 NEXT J
110 NEXT I
120 FOR K = 1 TO 10
130 MAT C = A * B
140 NEXT K
150 LET S1 = 0
160 FOR I = 1 TO 400
170 FOR J = 1 TO 400
180 LET S1 = S1 + C(I,J) * (I + 2*J)
190 NEXT J
200 LET S1 = S1 - 1000003*INT(S1/1000003)
210 NEXT I
220 PRINT "PRODUCT 400 X 400"
230 PRINT "CHECKSUM", S1
240 PRINT "CORNERS", C(1,1); C(1,400); C(400,1); C(400,400)
250 END
