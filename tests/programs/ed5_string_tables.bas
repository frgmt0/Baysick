10 REM STRING TABLES (LANGUAGE.MD 4.4, 7.11, 7.14)
20 DIM T$(2, 3)
30 FOR I = 1 TO 2
40 FOR J = 1 TO 3
50 LET T$(I, J) = STR$(10 * I + J)
60 NEXT J
70 NEXT I
80 MAT PRINT T$
90 MAT PRINT T$;
100 READ T$(0, 0), U$(10, 10)
110 PRINT T$(0, 0); U$(10, 10); LEN(U$(0, 0))
120 MAT READ T$(1, 2)
130 MAT PRINT T$;
140 PRINT T$(1, 1); T$(1, 2); T$(0, 0)
150 LET T$(1, 2) = T$(0, 0)
160 IF T$(1, 2) = "ZERO" THEN 180
170 PRINT "BAD"
180 CHANGE T$(1, 1) TO L
190 CHANGE L TO U$(1, 2)
200 PRINT U$(1, 2), L(0)
210 LET V$(1) = "LIST"
220 MAT PRINT V$;
230 DATA ZERO, TEN, P, Q
240 END
