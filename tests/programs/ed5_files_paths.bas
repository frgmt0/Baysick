10 REM QUOTED NAMES, SUBDIRECTORIES, DESIGNATOR EXPRESSIONS (LANGUAGE.MD 7.21)
20 FILES "sub/lower.txt"; "sub/written.txt"
30 LET F(1) = 1.9
40 INPUT #F(1), A$
50 PRINT A$; LEN(A$)
60 LET K = 2
70 SCRATCH #K
80 PRINT #K * 1, "WRITTEN"; LEN(A$)
90 PRINT #-0.5, "MINUS HALF IS FILE 0"
100 INPUT #F(1) - .5, B$
110 PRINT #K, B$
120 END
