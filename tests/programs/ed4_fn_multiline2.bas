10 REM MULTI-LINE FUNCTIONS: LOCAL PARAMETERS, LOOPS, EARLY EXIT
20 DEF FNG(A, B)
30 IF B = 0 THEN 70
40 LET T = A - INT(A/B)*B
50 LET A = B
55 LET B = T
60 GOTO 30
70 LET FNG = A
80 FNEND
90 DEF FNS(N)
100 FOR N = N TO 1 STEP -1
110 LET FNS = FNS + N
120 NEXT N
130 FNEND
140 DEF FNZ
150 PRINT "IN FNZ, FNZ ="; FNZ
160 READ Q
170 LET FNZ = Q * 2
180 FNEND
190 DEF FNL(X) = FNG(X, 12) + FNS(3)
200 LET A = 111
210 LET B = 222
220 LET N = 333
230 PRINT FNG(48, 18); FNG(17, 5); A; B; T
240 PRINT FNS(4); FNS(0); N
250 PRINT FNZ; FNZ
260 PRINT FNL(30)
270 DATA 21, 4
280 END
