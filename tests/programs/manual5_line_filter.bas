10 REM A FILTER: NUMBER THE LINES OF THE STANDARD INPUT INTO A FILE
20 FILES NUMBERED.TXT
30 SCRATCH #1
40 LET N = 0
50 IF END #0 THEN 110
60 INPUT #0, L$
70 LET N = N + 1
80 PRINT #1, STR$(N); ": "; L$
90 LET C = C + LEN(L$)
100 GOTO 50
110 PRINT N; "LINES,"; C; "CHARACTERS"
120 PRINT #1, "END"
130 END
