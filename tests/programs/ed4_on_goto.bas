10 FOR I = 1 TO 6
20 READ X
30 ON X GO TO 100, 200, 300
100 PRINT X; "ONE"
110 GOTO 400
200 PRINT X; "TWO"
210 GOTO 400
300 PRINT X; "THREE"
400 NEXT I
410 LET S = -7
420 ON SGN(S) + 2 THEN 500, 510, 520
500 PRINT "NEGATIVE"
505 GOTO 530
510 PRINT "ZERO"
515 GOTO 530
520 PRINT "POSITIVE"
530 ON 1 GOTO 540
540 PRINT "DONE"
900 DATA 1, 2, 3, 2.9, 3.99, 1.0001
999 END
