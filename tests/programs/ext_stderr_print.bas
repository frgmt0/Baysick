10 REM PRINT #-1 WRITES STANDARD ERROR WITH ITS OWN COLUMN STATE (LANGUAGE.MD 15.3)
20 PRINT "OUT";
30 PRINT #-1, "ERR", 1; 2
40 PRINT #-1, TAB(10); "T"; TAB(5); "U"
50 LET E = -1.5
60 PRINT #E, "A", "B", "C", "D", "E", "F"
70 PRINT " MORE"
80 PRINT #-1, "   ";
90 PRINT #-1, 123456789; -0.5,
100 PRINT #-1
110 PRINT #-1, "LAST";
120 END
