10 REM DEF FN: ONE PARAMETER, GLOBALS VISIBLE, DEF MAY APPEAR ANYWHERE
20 LET Y = 30
30 PRINT FNX(40)
40 LET P = 3.14159265/180
50 FOR X = 0 TO 90 STEP 30
60 PRINT X, FNF(X), FNL(X+1)
70 NEXT X
80 PRINT "X IS STILL"; X
90 PRINT FNA(FNA(2)), FNB(3)
100 DEF FNX(X) = SQR(X*X + Y*Y)
110 DEF FNF(Z) = SIN(Z*P)
120 DEF FNL(X) = LOG(X)/LOG(10)
130 DEF FNA(Q) = Q*Q + 1
140 DEF FNB(B1) = FNA(B1) * 2 + B1
150 END
