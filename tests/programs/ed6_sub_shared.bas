10 REM SHARED DATA AND FILES, A FUNCTION CALLING A SUBPROGRAM (LANGUAGE.MD 7.27)
20 FILES LOG.TXT
30 SCRATCH #1
40 READ A
50 CALL "READER"
60 READ B
70 PRINT A; B
80 PRINT FNC(5)
90 PRINT #1, "MAIN"
100 CALL "LOGGER"
110 RESTORE
120 CALL "READER"
130 DATA 1, 2, 3
140 DEF FNC(P)
150 CALL "DOUBLE": P, R
160 LET FNC = R + P
170 FNEND
180 END
200 SUB "READER"
210 READ X
220 PRINT "READ"; X
230 SUBEND
300 SUB "DOUBLE": V, W
310 LET W = 2 * V
320 LET V = 0
330 SUBEND
400 SUB "LOGGER"
410 PRINT #1, "SUB"
420 SUBEND
