10 REM FOR WITH IMPLIED STEP 1; AFTER THE LOOP THE VARIABLE KEEPS ITS LAST VALUE
20 FOR I = 1 TO 5
30 PRINT I;
40 NEXT I
50 PRINT
60 PRINT "AFTER LOOP I ="; I
70 FOR X = 7 TO 100 STEP 7
80 PRINT X;
90 NEXT X
100 PRINT
110 PRINT "AFTER LOOP X ="; X
120 FOR J = -3 TO 12 STEP 2
130 PRINT J;
140 NEXT J
150 PRINT
160 PRINT "J ="; J
170 END
