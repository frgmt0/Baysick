10 REM STR$ IS THE PRINTED FIELD WITHOUT ITS BLANKS (LANGUAGE.MD 6.1)
20 PRINT "["STR$(5)"]["STR$(-0)"]["STR$(.5)"]["STR$(-1234567)"]"
30 PRINT "["STR$(1/3)"]["STR$(2/3)"]["STR$(999999.4)"]["STR$(1E9)"]"
40 PRINT "["STR$(-2.35E-4)"]["STR$(6.02E23)"]["STR$(1E-7)"]["STR$(100/3)"]"
50 LET A$ = STR$(-17)
60 PRINT A$, LEN(A$)
70 LET X = 2.5
80 PRINT STR$(X * 2); "/"; STR$(X)
90 CHANGE STR$(123) TO L
100 PRINT L(0); L(1); L(2); L(3)
110 PRINT VAL(STR$(123456)) + 1
120 IF STR$(10) = "10" THEN 140
130 PRINT "NO"
140 PRINT LEN(STR$(-1E-10)); STR$(-1E-10)
150 END
