10 REM A LOOP WHOSE INITIAL VALUE IS ALREADY PAST THE LIMIT IS NOT PERFORMED;
20 REM THE VARIABLE IS LEFT AT INITIAL VALUE MINUS STEP (1964 MANUAL 2.6.5)
30 FOR Z = 2 TO -2
40 PRINT "NEVER"
50 NEXT Z
60 PRINT "Z ="; Z
70 FOR W = 1 TO 5 STEP -1
80 PRINT "NEVER"
90 NEXT W
100 PRINT "W ="; W
110 FOR V = 0 TO 0
120 PRINT "ONCE WITH V ="; V
130 NEXT V
140 PRINT "V ="; V
150 END
