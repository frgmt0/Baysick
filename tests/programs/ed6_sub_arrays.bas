10 REM ARRAY PARAMETERS AND LOCAL ARRAYS (LANGUAGE.MD 7.27)
20 DIM A(4), T(2, 3)
30 FOR I = 1 TO 4
40 LET A(I) = I * I
50 NEXT I
60 CALL "SUMLIST": A(), S
70 PRINT "SUM"; S
80 CALL "OUTER": A()
90 CALL "FILL": T()
100 PRINT T(2, 3); T(1, 1)
110 CALL "ONES": A()
120 CALL "ONES": T()
130 PRINT A(0); A(4); T(0, 0); T(2, 3)
140 DIM N$(3)
150 LET N$(1) = "ONE"
160 LET N$(2) = "TWO"
170 CALL "JOIN": N$(), R$
180 PRINT R$
190 CALL "LOCAL": 1
200 CALL "LOCAL": 2
210 CALL "REDIM": A()
220 MAT READ A
230 READ Z
240 PRINT A(1); A(2); Z
250 DATA 7, 8, 9
260 END
300 SUB "SUMLIST": L(), S
310 LET S = 0
320 FOR K = 1 TO 4
330 LET S = S + L(K)
340 NEXT K
350 SUBEND
400 SUB "OUTER": Z()
410 CALL "SUMLIST": Z(), S2
420 PRINT "OUTER"; S2
430 SUBEND
500 SUB "FILL": M()
510 FOR I = 0 TO 2
520 FOR J = 0 TO 3
530 LET M(I, J) = 10 * I + J
540 NEXT J
550 NEXT I
560 SUBEND
600 SUB "ONES": X()
610 MAT X = CON
620 SUBEND
700 SUB "JOIN": L$(), R$
710 LET R$ = L$(1) & "," & L$(2) & "," & L$(3)
720 SUBEND
800 SUB "LOCAL": N
810 DIM Q(3), Q$(2)
820 PRINT Q(1); LEN(Q$(1))
830 LET Q(1) = N
840 LET Q$(1) = "SET"
850 SUBEND
900 SUB "REDIM": X()
910 MAT X = ZER(2)
920 SUBEND
