10 DIM C(300)
20 INPUT A$
30 CHANGE A$ TO C
40 PRINT C(0);
50 FOR I = 1 TO C(0)
60 PRINT C(I);
70 NEXT I
80 PRINT
90 REM REVERSE THE STRING
100 LET N = C(0)
110 FOR I = 1 TO N
120 LET D(I) = C(N + 1 - I)
130 NEXT I
140 LET D(0) = N
150 CHANGE D TO B$
160 PRINT B$
170 REM BUILD QUOTES AND AN EMPTY STRING
180 LET Q(0) = 3
190 LET Q(1) = 34
200 LET Q(2) = 65.4
210 LET Q(3) = 33.5
220 CHANGE Q TO Q$
230 PRINT Q$
240 LET Q(0) = .4
250 CHANGE Q TO Q$
260 PRINT "["; Q$; "]"
270 CHANGE "" TO Q
280 PRINT Q(0); Q(1)
290 CHANGE "HI" TO Q
300 PRINT Q(0); Q(1); Q(2); Q(3)
310 END
