10 REM INPUT # AND IF END # (LANGUAGE.MD 7.21, 7.25, 7.26)
20 FILES data.txt; NOSUCH/FILE.TXT
30 INPUT #1, A$, X, Y
40 PRINT A$; X; Y
50 INPUT #1, A$, X
60 PRINT A$; X
70 INPUT #1, A$, X, Y
80 PRINT "["A$"]"; X; Y
90 INPUT #1, Z
100 PRINT Z
110 IF END #1 THEN 150
120 INPUT #1, A$
130 PRINT A$
140 GOTO 110
150 PRINT "END OF DATA"
160 END
