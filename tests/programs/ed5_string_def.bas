10 REM SINGLE-LINE STRING FUNCTIONS AND STRING PARAMETERS (LANGUAGE.MD 7.10.1)
20 DEF FNA$(X) = STR$(X * X)
30 DEF FNB$(N, S$) = S$
40 DEF FNC(S$, K) = LEN(S$) * K
50 DEF FNG$ = "GREETINGS"
60 PRINT FNA$(3); " "; FNB$(1, "ONE"); " "; FNC("ABC", 2)
70 LET A$ = FNA$(12)
80 PRINT A$, LEN(A$), FNG$
90 IF FNA$(2) = "4" THEN 110
100 PRINT "BAD"
110 PRINT FNB$(0, FNA$(5)); FNC(FNG$, 1)
120 LET B$ = "XYZ"
130 PRINT FNC(B$, 10); B$
140 CHANGE FNB$(0, "HI") TO L
150 PRINT L(0); L(1); L(2)
160 PRINT VAL(FNA$(1.5)) + ASC(FNG$)
170 IF FNA$(1) = FNA$(-1) THEN 190
180 PRINT "DIFFERENT"
190 PRINT FNA$(1); FNA$(2); FNA$(3)
200 END
