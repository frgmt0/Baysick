10 REM KEYWORDS THEN TO STEP ARE RECOGNISED ONLY WHERE AN OPERATOR MAY APPEAR
20 LET T = 2
30 LET A = 1
40 LET B = 4
50 FOR X = A TO B STEP T
60 PRINT X;
70 NEXT X
80 PRINT
90 IF A = T THEN 200
100 IF T = T THEN 120
110 PRINT "NOT REACHED"
120 LET E = 3
130 REM E FOLLOWED BY A DIGIT IS AN EXPONENT; OTHERWISE IT IS THE VARIABLE E
140 PRINT 2E1, 2*E, E+1, 1E-1
150 FOR S = E TO E+2 STEP E-2
160 PRINT S;
170 NEXT S
180 PRINT
190 PRINT SIN(0); COS(0); TAN(0); ATN(0); EXP(0); ABS(-1); LOG(1); SQR(1); INT(1.5)
200 END
