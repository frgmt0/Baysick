10 DEF FNA = 3.1416*R^2
20 DEF FNB(X,Y) = 3*X*Y - Y^3
30 DEF FNC(X,Y,Z,W) = FNB(X,Y)/FNB(Z,W)
40 DEF FNE(X) = EXP(-X^2 + 5)
50 DEF FNH(A,B,C,D,E,F,G,H) = A+2*B+3*C+4*D+5*E+6*F+7*G+8*H
60 DEF FNR = R
70 LET R = 2
80 PRINT FNA; FNR
90 LET R = 1
100 PRINT FNA
110 LET X = 100
120 LET Y = 200
130 PRINT FNB(2, 1); FNB(1, 2); X; Y
140 PRINT FNC(2, 1, 1, 2)
150 PRINT FNE(.1); FNE(2)
160 PRINT FNH(1, 1, 1, 1, 1, 1, 1, 1); FNH(8, 7, 6, 5, 4, 3, 2, 1)
170 PRINT FNB(FNB(1, 1), FNR + 1)
180 END
