10 REM ZONED AND PACKED LAYOUT, LONG ROWS, SEVERAL MATRICES, PENDING LINE
20 DIM A(2,7), B(2,2), V(20)
30 FOR I = 1 TO 2
40 FOR J = 1 TO 7
50 LET A(I,J) = 10*I + J
60 NEXT J
70 NEXT I
80 MAT B = CON(2,2)
90 FOR I = 1 TO 20
100 LET V(I) = I*I*I
110 NEXT I
120 MAT PRINT A
130 MAT PRINT A;
140 MAT PRINT A, B; B
150 PRINT "LABEL",
160 MAT PRINT B
170 PRINT "PACKED";
180 MAT PRINT V;
190 MAT PRINT V
200 PRINT "DONE"
210 END
