10 REM ALL SIX RELATIONS
20 FOR A = 1 TO 3
30 PRINT A;
40 IF A = 2 THEN 100
50 PRINT "NE";
60 GOTO 110
100 PRINT "EQ";
110 IF A <> 2 THEN 130
120 PRINT "(NOT NE)";
130 IF A < 2 THEN 160
140 PRINT "GE";
150 GOTO 170
160 PRINT "LT";
170 IF A <= 2 THEN 200
180 PRINT "GT"
190 GOTO 230
200 IF A > 1 THEN 220
210 PRINT "LE ONE"
215 GOTO 230
220 PRINT "LE AND GT ONE"
230 IF A >= 3 THEN 250
240 NEXT A
250 PRINT "DONE"; A
260 END
