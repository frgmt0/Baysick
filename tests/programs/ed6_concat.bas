10 REM CONCATENATION (LANGUAGE.MD 4.5, 4.6)
20 LET A$ = "AB"
30 LET B$ = A$ & "CD" & A$
40 PRINT B$
50 PRINT A$ & "-" & B$; LEN(A$ & B$)
60 LET A$ = A$ & A$
70 PRINT A$
80 IF A$ & "X" = "ABABX" THEN 100
90 PRINT "WRONG"
100 PRINT "COMPARE OK"
110 CHANGE "A" & "B" TO V
120 PRINT V(0); V(1); V(2)
130 DEF FNJ$(X$, Y$) = X$ & "+" & Y$
140 PRINT FNJ$("P" & "Q", STR$(12) & "R")
150 LET C$ = ""
160 FOR I = 1 TO 5
170 LET C$ = C$ & STR$(I)
180 NEXT I
190 PRINT C$
200 DEF FNZ$(N)
210 LET D$ = "CHANGED"
220 LET FNZ$ = "Z"
230 FNEND
240 LET D$ = "ORIG"
250 PRINT D$ & FNZ$(1)
260 LET L$ = ""
270 FOR I = 1 TO 10
280 LET L$ = L$ & "0123456789"
290 NEXT I
300 PRINT LEN(L$)
310 PRINT L$
320 LET E$ = SEG$(L$, 1, 3) & SEG$(L$, 98, 100)
330 PRINT E$
340 PRINT ASC("" & "Z"); VAL("1" & "2" & ".5")
350 END
