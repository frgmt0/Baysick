10 REM TEXT PROCESSING: WORDS, LETTERS AND THE LONGEST WORD PER LINE
20 REM READS LINES UNTIL A LINE "/*"; NO COMMAS OR QUOTES IN THE TEXT
30 DIM C(300), W(300), F(26)
40 LET L = 0
50 LET T = 0
60 INPUT A$
70 IF A$ = "/*" THEN 400
80 LET L = L + 1
90 CHANGE A$ TO C
100 LET N = 0
110 LET M = 0
120 LET B$ = ""
130 LET K = 0
140 FOR I = 1 TO C(0) + 1
150 IF I > C(0) THEN 190
160 LET X = C(I)
170 IF X = 32 THEN 190
175 GOSUB 600
180 GOTO 260
190 IF K = 0 THEN 260
200 LET N = N + 1
210 IF K <= M THEN 250
220 LET M = K
230 LET W(0) = K
240 CHANGE W TO B$
250 LET K = 0
260 NEXT I
270 LET T = T + N
280 PRINT L; TAB(8); N; "WORDS, LONGEST: "; B$
290 GOTO 60
400 PRINT "LINES:"; L, "WORDS:"; T
410 FOR J = 1 TO 26
420 IF F(J) = 0 THEN 460
430 LET W(0) = 1
440 LET W(1) = 64 + J
450 CHANGE W TO B$
455 PRINT B$; F(J);
460 NEXT J
470 PRINT
480 STOP
600 REM ADD BYTE X TO THE CURRENT WORD; COUNT LETTERS
610 LET K = K + 1
620 LET W(K) = X
630 IF X < 97 THEN 650
640 LET X = X - 32
650 IF X < 65 THEN 680
660 IF X > 90 THEN 680
670 LET F(X - 64) = F(X - 64) + 1
680 RETURN
999 END
