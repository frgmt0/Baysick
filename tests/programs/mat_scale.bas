10 REM CONSTANT MULTIPLE (K)*A; K IS ANY FORMULA
20 DIM A(2,2), C(2,2)
30 MAT READ A
40 MAT C = (2)*A
50 MAT PRINT C
60 LET K = 3
70 MAT C = (K/2 + 1)*A
80 MAT PRINT C
90 MAT C = (-1)*A
100 MAT PRINT C
110 MAT A = (.5)*A
120 MAT PRINT A
130 MAT C = (0)*A
140 MAT PRINT C
150 DATA 1, -2, 0, 4.5
160 END
