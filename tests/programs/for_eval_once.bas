10 REM INITIAL, LIMIT AND STEP ARE EVALUATED ONCE, IN THAT ORDER, AT FOR
20 LET N = 3
30 LET S = 1
40 FOR I = 1 TO N STEP S
50 PRINT I; N; S
60 LET N = 10
70 LET S = 5
80 NEXT I
90 PRINT "I ="; I
100 REM CHANGING THE LOOP VARIABLE IN THE BODY AFFECTS THE NEXT TEST
110 FOR K = 1 TO 10
120 PRINT K;
130 LET K = K + 2
140 NEXT K
150 PRINT
160 PRINT "K ="; K
170 REM JUMPING OUT OF A LOOP IS ALLOWED
180 FOR M = 1 TO 100
190 IF M = 4 THEN 210
200 NEXT M
210 PRINT "LEFT AT M ="; M
220 END
