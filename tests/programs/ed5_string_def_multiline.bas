10 REM MULTI-LINE STRING FUNCTIONS (LANGUAGE.MD 7.10.1)
20 DEF FNR$(S$)
30 CHANGE S$ TO A
40 LET N = A(0)
50 FOR I = 1 TO N
60 LET B(I) = A(N + 1 - I)
70 NEXT I
80 LET B(0) = N
90 CHANGE B TO S$
100 LET FNR$ = S$
110 FNEND
120 DEF FNP$(K, T$)
130 IF K <= 0 THEN 170
140 LET FNP$ = T$
150 LET T$ = "CHANGED"
160 PRINT "INSIDE "; T$
170 FNEND
180 LET W$ = "STRESSED"
190 PRINT FNR$(W$); " "; W$
200 PRINT "["FNP$(0, W$)"]"
210 PRINT "["FNP$(1, W$)"]"; W$
220 LET W$ = FNR$(FNR$("ABC"))
230 PRINT W$
240 LET C$ = FNP$(2, "X")
250 PRINT C$; LEN(C$)
260 IF FNP$(1, "A") < FNP$(1, "B") THEN 280
270 PRINT "NOT LESS"
280 END
