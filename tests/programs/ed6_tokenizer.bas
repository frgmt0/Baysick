10 REM TOKENIZER AND RECURSIVE-DESCENT EVALUATOR: SUB, SEG$, POS, &, FILES, IF END
20 FILES EXPR.TXT; RESULT.TXT
30 SCRATCH #2
40 LET N = 0
50 IF END #1 THEN 140
60 INPUT #1, L$
70 LET P = 1
80 CALL "EXPR": L$, P, V
90 LET R$ = L$ & " = " & STR$(V)
100 PRINT R$
110 PRINT #2, R$
120 LET N = N + 1
130 GOTO 50
140 PRINT "LINES"; N
150 END
200 SUB "EXPR": S$, P, V
210 CALL "TERM": S$, P, V
220 LET C$ = SEG$(S$, P, P)
230 IF C$ = "+" THEN 260
240 IF C$ = "-" THEN 260
250 GOTO 330
260 LET P = P + 1
270 CALL "TERM": S$, P, W
280 IF C$ = "-" THEN 310
290 LET V = V + W
300 GOTO 220
310 LET V = V - W
320 GOTO 220
330 SUBEND
400 SUB "TERM": S$, P, V
410 CALL "FACTOR": S$, P, V
420 IF SEG$(S$, P, P) <> "*" THEN 470
430 LET P = P + 1
440 CALL "FACTOR": S$, P, W
450 LET V = V * W
460 GOTO 420
470 SUBEND
500 SUB "FACTOR": S$, P, V
510 IF SEG$(S$, P, P) <> "(" THEN 560
520 LET P = P + 1
530 CALL "EXPR": S$, P, V
540 LET P = P + 1
550 GOTO 630
560 LET V = 0
570 LET C$ = SEG$(S$, P, P)
580 IF LEN(C$) = 0 THEN 630
590 LET D = POS("0123456789", C$)
600 IF D = 0 THEN 630
610 LET V = V * 10 + D - 1
620 LET P = P + 1
625 GOTO 570
630 SUBEND
