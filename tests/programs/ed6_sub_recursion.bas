10 REM RECURSION, PRIVATE VARIABLES PER ACTIVATION (LANGUAGE.MD 7.27)
20 FOR N = 0 TO 6
30 CALL "FACT": N, F
40 PRINT N; F
50 NEXT N
60 CALL "FIB": 15, R
70 PRINT "FIB 15 ="; R
80 LET D = 0
90 CALL "DEPTH": 0, D
100 PRINT "DEPTH"; D
110 CALL "HANOI": 4, 1, 3, 2, M
120 PRINT "MOVES"; M
130 END
200 SUB "FACT": K, R
210 IF K > 1 THEN 240
220 LET R = 1
230 GOTO 270
240 LET T = K
250 CALL "FACT": K - 1, R
260 LET R = R * T
270 SUBEND
300 SUB "FIB": K, R
310 IF K >= 2 THEN 340
320 LET R = K
330 GOTO 370
340 CALL "FIB": K - 1, A
350 CALL "FIB": K - 2, B
360 LET R = A + B
370 SUBEND
400 SUB "DEPTH": K, D
410 IF K = 1000 THEN 440
420 CALL "DEPTH": K + 1, D
430 GOTO 450
440 LET D = K
450 SUBEND
500 SUB "HANOI": N, F, T, V, M
510 IF N = 0 THEN 550
520 CALL "HANOI": N - 1, F, V, T, M
530 LET M = M + 1
540 CALL "HANOI": N - 1, V, T, F, M
550 SUBEND
