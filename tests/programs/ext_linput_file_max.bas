10 REM LINPUT # ACCEPTS LINES OF EXACTLY 65 536 BYTES: WITH LF, WITH CR LF, UNTERMINATED (LANGUAGE.MD 15.2, 12)
20 FILES MAX.TXT
30 FOR I = 1 TO 3
40 LINPUT #1, L$
50 PRINT LEN(L$)
60 PRINT SEG$(L$, 1, 1); SEG$(L$, 65536, 65536)
70 NEXT I
80 IF END #1 THEN 100
90 PRINT "MORE"
100 PRINT "DONE"
110 END
