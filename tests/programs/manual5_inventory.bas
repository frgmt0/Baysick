10 REM AN INVENTORY FILE IS WRITTEN, THEN READ BACK FOR A REPORT
20 FILES STOCK
30 SCRATCH #1
40 FOR I = 1 TO 4
50 READ N$, Q, P
60 PRINT #1, N$; ","; Q; ","; P
70 NEXT I
80 RESTORE #1
90 PRINT "ITEM"; TAB(12); "QTY"; TAB(20); "VALUE"
100 LET T = 0
110 IF END #1 THEN 180
120 INPUT #1, N$, Q, P
130 LET V = Q * P
140 LET T = T + V
150 LET V$ = STR$(V)
160 PRINT N$; TAB(15 - LEN(STR$(Q))); STR$(Q); TAB(25 - LEN(V$)); V$
170 GOTO 110
180 PRINT "TOTAL"; TAB(25 - LEN(STR$(T))); STR$(T)
190 DATA BOLTS, 120, .25, NUTS, 300, .5
200 DATA WASHERS, 1000, .125, "LARGE GEARS", 4, 12.5
210 END
