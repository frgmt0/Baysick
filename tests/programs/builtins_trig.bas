10 REM SIN COS TAN ATN, ARGUMENTS IN RADIANS
20 LET P = 3.14159265
30 PRINT SIN(0), SIN(P/6), SIN(P/2), SIN(1), SIN(-1)
40 PRINT COS(0), COS(P/3), COS(P), COS(1), COS(2)
50 PRINT TAN(0), TAN(P/4), TAN(1), TAN(-.5), TAN(1.5)
60 PRINT ATN(0), ATN(1), 4*ATN(1), ATN(-1), ATN(1E6)
70 PRINT ATN(TAN(.5)), SIN(-P/6)
80 END
