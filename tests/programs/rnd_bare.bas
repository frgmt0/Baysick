10 REM BARE RND AND RND(ANYTHING) DRAW FROM THE SAME STREAM
20 LET A = RND
30 LET B = RND(17)
40 LET C = RND(-5)
50 PRINT A, B, C
60 FOR I = 1 TO 1000
70 LET R = RND(0)
80 IF R <= 0 THEN 200
90 IF R >= 1 THEN 200
100 NEXT I
110 PRINT "1000 VALUES STRICTLY BETWEEN 0 AND 1, LAST WAS"; R
120 STOP
200 PRINT "OUT OF RANGE"; R
210 END
