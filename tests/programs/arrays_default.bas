10 REM WITHOUT DIM EVERY SUBSCRIPT RUNS FROM 0 TO 10
20 FOR I = 0 TO 10
30 LET A(I) = I*I
40 NEXT I
50 FOR I = 0 TO 10
60 PRINT A(I);
70 NEXT I
80 PRINT
90 FOR I = 0 TO 10
100 FOR J = 0 TO 10
110 LET T(I,J) = I*100 + J
120 NEXT J
130 NEXT I
140 PRINT T(0,0), T(10,10), T(3,7), T(7,3)
150 REM SUBSCRIPTS ARE ROUNDED TO THE NEAREST INTEGER
160 PRINT A(2.4), A(2.5), A(9.6)
170 REM THE SAME LETTER MAY NAME A SIMPLE VARIABLE AND A LIST
180 LET A = -1
190 PRINT A, A(1)
200 END
