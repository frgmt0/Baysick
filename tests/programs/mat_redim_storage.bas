10 REM REDIMENSIONING REINTERPRETS STORAGE (THE 1968 MANUAL'S EXAMPLE)
20 DIM M(10,10)
30 LET M(1,0) = 1
40 LET M(2,0) = 1
50 MAT READ M(2,2)
60 PRINT M(1,0); M(2,0)
70 LET M(0,1) = 7
80 MAT M = ZER(5,1)
90 PRINT M(0,1); M(3,1)
100 MAT M = CON(2,4)
110 PRINT M(0,1); M(1,0); M(1,1); M(2,4)
120 DATA 1, 2, 3, 4
130 END
