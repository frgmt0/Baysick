10 REM LINPUT TARGETS: LIST AND TABLE ELEMENTS, DEF AND SUB PARAMETERS (LANGUAGE.MD 15.2)
20 DEF FNR$(P$)
30 LINPUT P$
40 LET FNR$ = P$ & "/" & P$
50 FNEND
60 DIM T$(2, 3)
70 LET I = 2
80 LINPUT L$(I)
90 LINPUT #0, T$(1, I + 1)
100 CALL "GET": S$
110 PRINT L$(2); "|"; T$(1, 3); "|"; S$
120 PRINT FNR$("UNUSED")
130 END
200 SUB "GET": A$
210 LINPUT #0, A$
220 SUBEND
