10 DEF FNM(X,Y)
20 LET FNM = X
30 IF Y <= X THEN 50
40 LET FNM = Y
50 FNEND
60 DEF FNF(N)
70 LET FNF = 1
80 FOR K = 1 TO N
90 LET FNF = K * FNF
100 NEXT K
110 FNEND
120 FOR I = 1 TO 4
130 READ A, B
140 PRINT A; B; FNM(A, B); FNF(I); K
150 NEXT I
160 PRINT FNF(10), FNF(0), K
170 DATA 3, 5, 7, -2, -1, -1, 0, .5
180 END
