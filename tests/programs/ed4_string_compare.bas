10 REM STRING RELATIONS (TRAILING BLANKS IGNORED, BYTE ORDER)
20 READ A$, B$
30 IF A$ = "*" THEN 999
40 PRINT "["; A$; "] ["; B$; "]";
50 IF A$ = B$ THEN 100
60 PRINT " <>";
70 GOTO 110
100 PRINT " =";
110 IF A$ < B$ THEN 140
120 PRINT " NOT <";
130 GOTO 150
140 PRINT " <";
150 IF A$ <= B$ GOTO 170
160 GOTO 180
170 PRINT " <=";
180 IF A$ > B$ THEN 200
190 GOTO 210
200 PRINT " >";
210 IF A$ >= B$ THEN 230
220 GOTO 240
230 PRINT " >=";
240 PRINT
250 GOTO 20
900 DATA "YES", "YES   ", A, B, "Z", "a", AB, ABC, "", "   ", " A", A
910 DATA "10", "9", ABC, ABD, "B", "A", "SAME", SAME, "*", "*"
999 END
