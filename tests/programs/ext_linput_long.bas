10 REM LINPUT OF 65 536-BYTE LINES, CR LF AND A LAST LINE WITHOUT LF (LANGUAGE.MD 15.2, 12)
20 LINPUT #0, A$
30 PRINT LEN(A$); SEG$(A$, 1, 3); SEG$(A$, 65534, 65537)
40 LINPUT B$
50 PRINT LEN(B$)
60 LINPUT #0, C$
70 PRINT LEN(C$); SEG$(C$, 65535, 65536)
80 IF END #0 THEN 100
90 PRINT "MORE"
100 END
