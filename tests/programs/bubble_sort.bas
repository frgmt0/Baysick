10 REM SORT A LIST READ FROM DATA
20 DIM L(20)
30 READ N
40 FOR I = 1 TO N
50 READ L(I)
60 NEXT I
70 FOR I = 1 TO N - 1
80 FOR J = 1 TO N - I
90 IF L(J) <= L(J+1) THEN 130
100 LET T = L(J)
110 LET L(J) = L(J+1)
120 LET L(J+1) = T
130 NEXT J
140 NEXT I
150 FOR I = 1 TO N
160 PRINT L(I);
170 NEXT I
180 PRINT
190 DATA 12
200 DATA 5, -3, 17.5, 0, 2, 99, -40, 8, 8, 1E3, .25, 6
210 END
