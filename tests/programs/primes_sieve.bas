10 REM SIEVE OF ERATOSTHENES UP TO 200
20 DIM P(200)
30 LET N = 200
40 FOR I = 2 TO N
50 LET P(I) = 1
60 NEXT I
70 FOR I = 2 TO SQR(N)
80 IF P(I) = 0 THEN 120
90 FOR J = I*I TO N STEP I
100 LET P(J) = 0
110 NEXT J
120 NEXT I
130 LET C = 0
140 FOR I = 2 TO N
150 IF P(I) = 0 THEN 180
160 PRINT I;
170 LET C = C + 1
180 NEXT I
190 PRINT
200 PRINT C; "PRIMES"
210 END
