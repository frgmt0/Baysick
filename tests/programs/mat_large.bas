10 REM LARGER MATRICES CHECKED AGAINST ORDINARY LOOPS (EXACT INTEGER DATA)
20 DIM A(70,300), B(300,50), C(70,50), D(70,50)
30 DIM P(37,53), Q(60,60), R(100,97), S(100,97)
40 FOR I = 1 TO 70
50 FOR J = 1 TO 300
60 LET T = I*J
70 LET A(I,J) = T - 9*INT(T/9) - 4
80 NEXT J
90 NEXT I
100 FOR I = 1 TO 300
110 FOR J = 1 TO 50
120 LET T = I + 2*J
130 LET B(I,J) = T - 7*INT(T/7) - 3
140 NEXT J
150 NEXT I
160 MAT C = A * B
170 LET E = 0
180 LET S1 = 0
190 FOR I = 1 TO 70
200 FOR J = 1 TO 50
210 LET X = 0
220 FOR K = 1 TO 300
230 LET X = X + A(I,K) * B(K,J)
240 NEXT K
250 IF X = C(I,J) THEN 270
260 LET E = E + 1
270 LET S1 = S1 + C(I,J) * (I + 2*J)
280 NEXT J
290 NEXT I
300 PRINT "PRODUCT 70 BY 300 BY 50"
310 PRINT "MISMATCHES", E
320 PRINT "CHECKSUM", S1
330 PRINT "CORNERS", C(1,1); C(1,50); C(70,1); C(70,50)
340 FOR I = 1 TO 37
350 FOR J = 1 TO 53
360 LET P(I,J) = 100*I + J
370 NEXT J
380 NEXT I
390 MAT Q = TRN(P)
400 LET E = 0
410 FOR I = 1 TO 37
420 FOR J = 1 TO 53
430 IF Q(J,I) = P(I,J) THEN 450
440 LET E = E + 1
450 NEXT J
460 NEXT I
470 PRINT "TRANSPOSE 37 BY 53 MISMATCHES", E; Q(53,37)
480 FOR I = 1 TO 100
490 FOR J = 1 TO 97
500 LET R(I,J) = I - J/4
510 NEXT J
520 NEXT I
530 MAT S = R + R
540 MAT S = S - R
550 MAT S = (-.5)*S
560 MAT S = S + R
590 LET E = 0
600 FOR I = 1 TO 100
610 FOR J = 1 TO 97
620 IF S(I,J) = .5*R(I,J) THEN 640
630 LET E = E + 1
640 NEXT J
650 NEXT I
660 PRINT "ELEMENTWISE 100 BY 97 MISMATCHES", E; S(100,97)
670 MAT D = C
680 MAT D = D - C
690 MAT D = ZER(7,7)
700 PRINT "DONE"
710 END
