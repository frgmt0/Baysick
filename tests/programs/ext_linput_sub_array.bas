10 REM LINPUT INTO A SUB STRING-ARRAY PARAMETER ELEMENT AND A SUB-LOCAL TABLE ELEMENT (LANGUAGE.MD 15.2, 7.27)
20 DIM M$(3)
30 CALL "P": M$()
40 PRINT M$(2); "|"; M$(3)
50 END
100 SUB "P": M$()
110 DIM T$(2, 2)
120 LINPUT M$(2)
130 LINPUT #0, M$(3)
140 LINPUT T$(1, 2)
150 PRINT "LOCAL:"; T$(1, 2)
160 SUBEND
