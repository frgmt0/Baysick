10 REM FRACTIONAL STEPS (1964 MANUAL EXAMPLE: X4 = 6, 6.25, ..., 9.25)
20 LET A = 0
30 FOR X4 = (17 + COS(A))/3 TO 3*SQR(10) STEP 1/4
40 PRINT X4;
50 NEXT X4
60 PRINT
70 PRINT "X4 ="; X4
80 FOR T = 0 TO 1 STEP .1
90 PRINT T;
100 NEXT T
110 PRINT
120 PRINT "T ="; T
130 FOR U = 1 TO 0 STEP -.25
140 PRINT U;
150 NEXT U
160 PRINT
170 END
