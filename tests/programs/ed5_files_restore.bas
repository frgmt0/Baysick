10 REM MODES, BUFFERING, RESTORE # AND SCRATCH # (LANGUAGE.MD 7.21-7.23)
20 FILES WORK.TXT; OLD.TXT; "WORK.TXT"
30 SCRATCH #1
40 FOR I = 1 TO 3
50 PRINT #1, I; ",ITEM"; I * 1.5
60 NEXT I
70 IF END #1 THEN 90
80 PRINT "WRITE MODE IS NOT AT ITS END"
90 IF END #3 THEN 110
100 PRINT "OUTPUT REACHED THE FILE EARLY"
110 RESTORE #1
120 RESTORE #3
130 IF END #1 THEN 170
140 INPUT #1, N, B$
150 PRINT N; "["B$"]"
160 GOTO 130
170 INPUT #3, N
180 PRINT "FILE 3 STARTS WITH"; N
190 SCRATCH #2
200 PRINT #2, "NEW"
210 SCRATCH #2
220 PRINT #2, "NEWER"
230 RESTORE #2
240 INPUT #2, C$
250 PRINT C$
260 END
