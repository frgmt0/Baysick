10 REM SCRATCH AND PRINT # WITH PER-FILE COLUMNS (LANGUAGE.MD 7.21-7.24, 8)
20 FILES OUT1.TXT
30 SCRATCH #1
40 SCRATCH #2
50 PRINT #1, "NAME", "SCORE"
60 FOR I = 1 TO 3
70 PRINT #1, "P"; I, I * I
80 PRINT #2, I;
90 NEXT I
100 PRINT "STDOUT", 1
110 PRINT #2
120 PRINT #2, "A",
130 PRINT #1, 1, 2, 3, 4, 5, 6
140 PRINT #1, "ABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOP"; 7
150 PRINT #0, "ZERO";
160 PRINT " AND STDOUT"
170 PRINT #1, TAB(10); "T"; TAB(3); "U"
180 PRINT #1
190 PRINT #1.9, "TRUNCATED"; -0.5
200 PRINT #2, "LAST";
210 FILES "out2.txt"
220 END
