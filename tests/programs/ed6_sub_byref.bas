10 REM CALL BY REFERENCE AND BY VALUE (LANGUAGE.MD 7.27)
20 LET A = 1
30 CALL "TWICE": A, A
40 PRINT A
50 LET B = 5
60 CALL "TWICE": (B), B
70 PRINT B
80 DIM L(5)
90 LET I = 2
100 CALL "SETI": L(I), I
110 PRINT L(2); L(3); I
120 CALL "INC": 2 * B
130 LET S$ = "X"
140 CALL "APP": S$, S$
150 PRINT S$
160 DIM M$(3)
170 LET M$(1) = "M"
180 CALL "APP": M$(1), "!" & "?"
190 PRINT M$(1)
200 CALL "APP": "LIT", S$
210 PRINT S$
220 CALL "PASS": A
230 PRINT A
240 END
300 SUB "TWICE": X, Y
310 LET X = X + 1
320 LET Y = Y * 10
330 SUBEND
400 SUB "SETI": E, J
410 LET E = 7
420 LET J = 3
430 LET E = E + 1
440 SUBEND
500 SUB "INC": X
510 LET X = X + 1
520 PRINT X
530 SUBEND
600 SUB "APP": T$, U$
610 LET T$ = T$ & U$
620 SUBEND
700 SUB "PASS": P
710 CALL "TWICE": P, P
720 SUBEND
