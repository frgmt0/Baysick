10 REM 3 X 3 MATRIX PRODUCT USING TABLES
20 DIM A(3,3), B(3,3), C(3,3)
30 FOR I = 1 TO 3
40 FOR J = 1 TO 3
50 READ A(I,J)
60 NEXT J
70 NEXT I
80 FOR I = 1 TO 3
90 FOR J = 1 TO 3
100 READ B(I,J)
110 NEXT J
120 NEXT I
130 FOR I = 1 TO 3
140 FOR J = 1 TO 3
150 LET C(I,J) = 0
160 FOR K = 1 TO 3
170 LET C(I,J) = C(I,J) + A(I,K) * B(K,J)
180 NEXT K
190 PRINT C(I,J),
200 NEXT J
210 PRINT
220 NEXT I
230 DATA 1, 2, 3, 4, 5, 6, 7, 8, 9
240 DATA 9, 8, 7, 6, 5, 4, 3, 2, 1
250 END
