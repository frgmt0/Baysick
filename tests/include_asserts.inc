// tests/include_asserts.inc -- layout assertions on the contract include
// files, shared by tests/include_check.s (Apple as, arm64 Mach-O) and
// tests/include_check_x86_64.s (GNU as, x86_64 ELF). Arch-neutral: only
// directives and expressions, `//` comments only at the start of a line
// (see the comment rule in docs/DESIGN.md section 3.4).
// The including file must have included baysick.inc first.
// Every condition is fully parenthesised: GNU as would read a bare
// `NAME == x` macro argument as the keyword argument `NAME=`.

.macro ASSERT cond, msg
.if !(\cond)
.error "\msg"
.endif
.endm

ASSERT ((IRM_ARRAYS + NUM_LETTERS*IRA_SIZE) == IRM_FUNCS), "IRM: arrays must end where funcs begin"
ASSERT ((1 << IRI_SHIFT) == IRI_SIZE),                     "IRI_SHIFT mismatch"
ASSERT ((IRI_IMM + 8) == IRI_SIZE),                        "IRI layout"
ASSERT ((IRS_LEN + 8) == IRS_SIZE),                        "IRS layout"
ASSERT ((IRA_FLAGS + 4) == IRA_SIZE),                      "IRA layout"
ASSERT ((RTA_CAP + 4) == RTA_SIZE),                        "RTA layout"
ASSERT ((MV_LD + 8) == MV_SIZE),                           "MV layout"
ASSERT ((KV_INV + 8) == KV_SIZE),                          "KV layout"
ASSERT ((KV_GEMM + 8*7) == KV_INV),                        "KV slots are consecutive pointers"
ASSERT (RT_MAT_SCRATCH_ELEMS >= LIM_ARRAY_ELEMS),          "MAT scratch holds any array"
ASSERT ((RT_KERN_INV_MAXN*RT_KERN_INV_MAXN) >= LIM_ARRAY_ELEMS), "INV workspace holds any square array"
ASSERT ((OP_MATINV - OP_MATREDIM) == 12),                  "MAT opcodes are contiguous"
ASSERT (OP_MATREDIM == (OP_STOP + 1)),                     "MAT opcodes follow OP_STOP"
ASSERT (MATPR_PACKED == (MATPR_ZONED + 1)),                "MATPR values"
ASSERT (MF_COUNT == (MF_INV + 1)),                         "MF_COUNT"
ASSERT ((BKD_RUNTIME_NAME + 8) == BKD_SIZE),               "BKD layout"
ASSERT ((TOK_ERR + 8) == TOK_SIZE),                        "TOK layout"
ASSERT ((OB_CAP + 8) == OB_SIZE),                          "OB layout"
ASSERT (SLOT_FOR_BASE == NUM_SCALAR_SLOTS),                "FOR slots must follow scalar slots"
ASSERT (NUM_SCALAR_SLOTS == NUM_LETTERS*SLOT_PER_LETTER),  "scalar slot count"
ASSERT ((OP_INT - OP_SIN) == 8),                           "builtin opcodes must be contiguous"
ASSERT ((BI_INT - BI_SIN) == (OP_INT - OP_SIN)),           "builtin ids parallel builtin opcodes"
ASSERT (ERR_TOO_MANY_FILES < ERR_FIRST_RUNTIME),           "compile-time codes below the run-time codes"
ASSERT (ERR_TOO_MANY_FILES == (ERR_ILLEGAL_TRANSFER + 1)), "TOO MANY FILES takes the last compile-time code"
ASSERT (ERR_CANT_OPEN_FILE == (ERR_OUT_OF_ROOM + 1)),      "Fifth Edition run-time codes follow OUT OF ROOM"
ASSERT ((ERR_ASC_EMPTY - ERR_CANT_OPEN_FILE) == 7),        "Fifth Edition run-time codes are contiguous"
ASSERT ((OP_STFV - OP_SLIT) == 29),                        "Fourth Edition opcodes are contiguous"
ASSERT (OP_SLIT == (OP_MATINV + 1)),                       "Fourth Edition opcodes follow OP_MATINV"
ASSERT ((OP_COT - OP_SGN) == (BI_COT - BI_SGN)),           "SGN/COT ids parallel their opcodes"
ASSERT (RESTORE_STR == (RESTORE_NUM + 1)),                 "RESTORE values"
ASSERT ((SD_CAP + 4) == SD_SIZE),                          "SD layout"
ASSERT (SD_SIZE == 16),                                    "SD records are 16 bytes (slist element stride)"
ASSERT (NUM_STRING_SLOTS == NUM_SCALAR_SLOTS),             "string slots number like scalar slots"
ASSERT (LIM_STRING_LEN == LIM_INPUT_LINE),                 "an input line always fits a string"
ASSERT (TAB_MODULUS == PRINT_LINE_WIDTH),                  "TAB modulus is the line width"
ASSERT (FUNC_KIND_FNML == (FUNC_KIND_FN + 1)),             "FUNC_KIND values"
ASSERT ((IRF_PARAMS + 4*LIM_FN_PARAMS) == IRF_SIZE),       "IRF layout"
ASSERT ((IRF_ENDLINE + 4) == IRF_PARAMS),                  "IRF parameter fields"
ASSERT ((IRF_NPARAMS + 4) == IRF_ENDLINE),                 "IRF parameter count"
ASSERT ((IRF_DEFLINE + 4) == IRF_NPARAMS),                 "IRF fields follow DEFLINE"
ASSERT ((IRM_FUNCS + NUM_FUNCS*IRF_SIZE) == IRM_SARRAYS),  "IRM: string lists follow funcs"
ASSERT ((IRM_SARRAYS + NUM_LETTERS*IRA_SIZE) == IRM_NSDATA), "IRM: string data count follows string lists"
ASSERT ((IRM_SDATA % 8) == 0),                             "IRM_SDATA alignment"
ASSERT ((IRM_FUNCS % 8) == 0),                             "IRM_FUNCS alignment"
ASSERT (PH_SDK < PH_LIMIT),                                "placeholders below PH_LIMIT"
// Fifth Edition
ASSERT ((OP_FRESTORE - OP_SCELL) == 13),                   "Fifth Edition opcodes are contiguous"
ASSERT (OP_SCELL == (OP_STFV + 1)),                        "Fifth Edition opcodes follow OP_STFV"
ASSERT (TK_SFN0 == (TK_SFN + 1)),                          "TK_SFN0 follows TK_SFN"
ASSERT (TK_SFN == (TK_FN0 + 1)),                           "Fifth Edition tokens follow TK_FN0"
ASSERT ((BI_STR - BI_LEN) == 3),                           "Fifth Edition builtins are contiguous"
ASSERT (BI_LEN == (BI_DET + 1)),                           "Fifth Edition builtins follow BI_DET"
ASSERT (KW_SCRATCH == (KW_FILES + 1)),                     "Fifth Edition keywords"
ASSERT (KW_FILES == (KW_FNEND + 1)),                       "Fifth Edition keywords follow KW_FNEND"
ASSERT (IRM_NSTEMPS == (IRM_SDATA + 8)),                   "IRM: Fifth Edition fields follow IRM_SDATA"
ASSERT ((IRM_NFILES + 4) == IRM_FILES),                    "IRM file count"
ASSERT ((IRM_FILES % 8) == 0),                             "IRM_FILES alignment"
ASSERT ((IRM_FILES + 8) == IRM_CAPFILES),                  "IRM file capacity"
ASSERT ((IRM_RESERVED5 + 4) == IRM_FNKINDS),               "IRM function kinds"
ASSERT ((FNK_SPARAM0 << (LIM_FN_PARAMS - 1)) < FNK_STRING), "FNK bits: string parameters below FNK_STRING"
ASSERT (FNK_SPARAMS_MASK == ((FNK_SPARAM0 << LIM_FN_PARAMS) - 1)), "FNK string-parameter mask"
ASSERT (LIM_FILE_NAME >= LIM_PHYS_LINE_LEN),               "every FILES name a line can hold fits LIM_FILE_NAME"
ASSERT (LIM_FILES == 8),                                   "eight files (GE 1970)"
ASSERT (RT_FILEBUF_SIZE == RT_OUTBUF_SIZE),                "file buffers like the stdout buffer"
ASSERT ((IRM_FNKINDS + NUM_FUNCS*4 + 4) == IRM_NSUBS),     "IRM: Sixth Edition fields follow IRM_FNKINDS"
ASSERT ((IRM_SIZE % 8) == 0),                              "IRM_SIZE alignment"
// Sixth Edition (unconditional values)
ASSERT ((OP_SUBRET - OP_SCAT) == 11),                      "Sixth Edition opcodes are contiguous"
ASSERT (OP_SCAT == (OP_FRESTORE + 1)),                     "Sixth Edition opcodes follow OP_FRESTORE"
ASSERT (TK_AMP == (TK_SFN0 + 1)),                          "TK_AMP follows TK_SFN0"
ASSERT (BI_POS == (BI_SEG + 1)),                           "Sixth Edition builtins are contiguous"
ASSERT (BI_SEG == (BI_STR + 1)),                           "Sixth Edition builtins follow BI_STR"
ASSERT (KW_CALL == (KW_SCRATCH + 1)),                      "Sixth Edition keywords follow KW_SCRATCH"
ASSERT (KW_SUBEND == (KW_CALL + 1)),                       "KW_SUBEND"
ASSERT (KW_SUB == (KW_SUBEND + 1)),                        "KW_SUB is tested after KW_SUBEND"
ASSERT (FUNC_KIND_SUB == (FUNC_KIND_FNML + 1)),            "FUNC_KIND_SUB"
ASSERT (SUBP_SARR == 3),                                   "SUBP kinds"
ASSERT (IRA_DIMS_ANY == 3),                                "IRA_DIMS_ANY"
ASSERT ((IRA_FLAG_PARAM & IRA_FLAG_DIMMED) == 0),          "IRA flags are distinct bits"
ASSERT ((IRM_NSUBS + 4) == IRM_CAPSUBS),                   "IRM sub count"
ASSERT ((IRM_SUBS % 8) == 0),                              "IRM_SUBS alignment"
ASSERT ((IRM_SUBS + 8) == IRM_PARENT),                     "IRM parent"
ASSERT ((IRM_PARENT + 8) == IRM_UNITIDX),                  "IRM unit index"
ASSERT ((IRM_SUBNAME % 8) == 0),                           "IRM_SUBNAME alignment"
ASSERT ((IRM_SUBNAMELEN + 4) == IRM_RESERVED6),            "IRM name length"
ASSERT ((IRM_RESERVED6 + 4) == IRM_SUBPARAMS),             "IRM sub parameters"
ASSERT ((IRM_SUBPARAMS + 4*LIM_SUB_PARAMS) == IRM_SUBPKINDS), "IRM sub parameter kinds"
ASSERT (LIM_SUB_PARAMS == 16),                             "sixteen SUB parameters"
ASSERT (LIM_CALL_DEPTH == LIM_GOSUB_DEPTH),                "CALL depth like GOSUB depth"
ASSERT (ERR_TOO_MANY_CALLS == (ERR_ASC_EMPTY + 1)),        "TOO MANY CALLS follows the Fifth Edition run-time codes"
ASSERT (ERR_END_RUNTIME == (ERR_TOO_MANY_CALLS + 1)),      "ERR_END_RUNTIME"
ASSERT (ERR_UNDEFINED_SUB == ERR_END_RUNTIME),             "Sixth Edition compile-time codes follow the run-time codes"
ASSERT ((ERR_ARG_MISMATCH - ERR_UNDEFINED_SUB) == 4),      "Sixth Edition compile-time codes are contiguous"
ASSERT ((SUBL_PDIMS + LIM_SUB_PARAMS) == SUBL_RECSIZE),    "SUBL layout"
ASSERT ((SUBL_DESCS % 8) == 0),                            "SUBL_DESCS alignment"
ASSERT (SUBD_ANY == (SUBD_TABLE + 1)),                     "SUBD values"
ASSERT (SUBD_TABLE == 2),                                  "SUBD_LIST/SUBD_TABLE equal RTA_DIMS"
ASSERT ((SUBL_NDESC + 4) == SUBL_COST),                    "SUBL_COST"
ASSERT ((SUBL_COST + 4) == SUBL_DESCS),                    "SUBL_DESCS"
ASSERT (RT_PROGRAM_STACK_BYTES == ((8 * LIM_CALL_WORDS) + RT_STACK_RESERVE_BYTES)), "program stack holds the call budget plus the reserve"
ASSERT ((RT_PROGRAM_STACK_BYTES % 65536) == 0),            "program stack is a multiple of every page size"
ASSERT (RT_FRAME_EXTRA_WORDS == 6),                        "frame overhead words"
// Baysick extensions (unconditional values)
ASSERT (OP_LINPUT == (OP_SUBRET + 1)),                     "extension opcodes follow OP_SUBRET"
ASSERT (OP_EXIT == (OP_LINPUT + 1)),                       "extension opcodes are contiguous"
ASSERT (KW_LINPUT == (KW_SUB + 1)),                        "KW_LINPUT follows KW_SUB"
ASSERT (ERR_EXT_FIRST == (ERR_ARG_MISMATCH + 1)),          "extension codes follow the codes of every edition"
ASSERT (ERR_EXT_FIRST_RUNTIME == ERR_EXT_FIRST),           "the extensions have run-time codes only"
ASSERT (ERR_EXIT_RANGE == ERR_EXT_FIRST_RUNTIME),          "EXIT STATUS OUT OF RANGE"
ASSERT (ERR_EXT_END_RUNTIME == (ERR_EXIT_RANGE + 1)),      "ERR_EXT_END_RUNTIME"
ASSERT (ERR_TABLE_SIZE == ERR_EXT_END_RUNTIME),            "ERR_TABLE_SIZE (Baysick extensions)"
ASSERT (FILE_NUM_STDERR == -1),                            "standard error is designator -1"
ASSERT (LIM_EXIT_STATUS == 255),                           "exit statuses 0..255"
ASSERT (EXIT_RUN_ERROR == 1),                              "a run-time error exits 1"
.if BSK_EXT_CONTRACT
ASSERT (OP_COUNT == (OP_EXIT + 1)),                        "OP_COUNT"
ASSERT (KW_COUNT == (KW_LINPUT + 1)),                      "KW_COUNT"
.else
ASSERT (OP_COUNT == (OP_SUBRET + 1)),                      "OP_COUNT (Sixth Edition staging)"
ASSERT (KW_COUNT == (KW_SUB + 1)),                         "KW_COUNT (Sixth Edition staging)"
.endif
ASSERT (TK_COUNT == (TK_AMP + 1)),                         "TK_COUNT"
ASSERT (BI_COUNT == (BI_POS + 1)),                         "BI_COUNT"
ASSERT ((IRM_SUBPKINDS + LIM_SUB_PARAMS) == IRM_SIZE),     "IRM layout (Sixth Edition)"
