10 REM SHAPED LIKE THE SEA FRONT END: SOURCE ON STDIN, TOKENS ON STDOUT,
15 REM ERRORS ON STDERR, EXIT STATUS 1 AFTER ERRORS (LANGUAGE.MD 15)
20 LET D$ = "0123456789"
30 LET A$ = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz_"
40 LET P$ = "()[]{},;=+-*/<>"
50 LET N = 0
60 LET E = 0
70 LET T = 0
100 IF END #0 THEN 500
110 LINPUT #0, L$
120 LET N = N + 1
130 LET I = 1
140 IF I > LEN(L$) THEN 100
150 LET C$ = SEG$(L$, I, I)
160 IF C$ = " " THEN 400
170 IF POS(D$, C$) > 0 THEN 250
180 IF POS(A$, C$) > 0 THEN 300
190 IF POS(P$, C$) > 0 THEN 350
200 IF C$ = "#" THEN 100
210 LET E = E + 1
220 PRINT #-1, "sea: error: " & STR$(N) & ":" & STR$(I) & ": unexpected '" & C$ & "'"
230 GOTO 400
250 LET K$ = D$
260 LET Y$ = "NUM"
270 GOTO 450
300 LET K$ = A$ & D$
310 LET Y$ = "IDENT"
320 GOTO 450
350 LET K$ = ""
360 LET Y$ = "PUNCT"
370 GOTO 450
400 LET I = I + 1
410 GOTO 140
450 LET J = I
460 GOSUB 600
470 LET T = T + 1
480 PRINT STR$(N); ":"; Y$; " "; SEG$(L$, I, J)
490 LET I = J + 1
495 GOTO 140
500 PRINT "LINES "; STR$(N); ", TOKENS "; STR$(T); ", ERRORS "; STR$(E)
510 IF E = 0 THEN 700
520 STOP 1
600 REM EXTEND THE TOKEN I..J WHILE THE NEXT BYTE IS IN K$
610 IF J >= LEN(L$) THEN 640
620 IF POS(K$, SEG$(L$, J + 1, J + 1)) = 0 THEN 640
630 LET J = J + 1
635 GOTO 610
640 RETURN
700 END
